layout {

    focus-ring {
        active-color   "#8b9bc1"
        inactive-color "#1a1d23"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8b9bc1"
        inactive-color "#1a1d23"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#1a1d2370"
    }

    tab-indicator {
        active-color   "#8b9bc1"
        inactive-color "#2f416a"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8b9bc180"
    }
}

recent-windows {
    highlight {
        active-color "#8b9bc1"
        urgent-color "#fd4663"
    }
}
