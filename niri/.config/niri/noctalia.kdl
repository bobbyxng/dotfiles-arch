layout {

    focus-ring {
        active-color   "#b2343d"
        inactive-color "#eae1e2"
        urgent-color   "#d51624"
    }

    border {
        active-color   "#b2343d"
        inactive-color "#eae1e2"
        urgent-color   "#d51624"
    }


    tab-indicator {
        active-color   "#b2343d"
        inactive-color "#e3b6b9"
        urgent-color   "#d51624"
    }

    insert-hint {
        color "#b2343d80"
    }
}

recent-windows {
    highlight {
        active-color "#b2343d"
        urgent-color "#d51624"
    }
}
